{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "game-server",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/api/*",
      "/ws",
      "/test"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LOBBY_HUB",
        "class_name": "LobbyHub"
      }
    ]
  },
  "exports": {
    "LobbyHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
